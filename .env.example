# 管理员密钥，调用 API 与登录后台使用
CHATGPT2API_AUTH_KEY=chatgpt2api

# 服务监听端口，默认 3000（Docker 部署无需设置）
PORT=3000

# 服务监听地址，留空监听全部网卡；设为 127.0.0.1 则仅本机可访问（端口仍由 PORT 决定）
# 直接运行二进制或 docker run -e 时生效；docker compose 不会透传，只允许本机访问请改用
# 端口映射 127.0.0.1:3000:80，在容器内设置本变量会导致容器外无法访问
BIND_ADDR=

# 数据库连接，留空使用 data/chatgpt2api.db
# PostgreSQL: postgresql://user:password@host:5432/chatgpt2api
# MySQL: mysql://user:password@host:3306/chatgpt2api
DATABASE_URL=
